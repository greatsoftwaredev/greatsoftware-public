---
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";
import AlpenglowHero from "../components/AlpenglowHero.astro";

const services = [
  {
    k: "ai consulting",
    t: "Agentic systems & orchestration",
    d: "Design, build, and tuning for AI agents and the workflows that coordinate them — systems reliable enough to run in production, not just demo well. Backed by a multi-agent platform already running real businesses, so it's daily practice, not theory.",
    cta: "Talk through a project",
  },
  {
    k: "custom builds",
    t: "Product & client builds",
    d: "From first prototype to shipped software. Every build starts from the real problem, proves it with the smallest version that works, and meets real users and real load early — before the polish goes on.",
    cta: "Start a build",
  },
];

const products = [
  {
    title: "Tenet",
    description: "Lead-generation websites built and rented to local service businesses, delivering the calls and web leads they generate.",
    status: "live" as const,
  },
  {
    title: "Changesets for VS Code",
    description: "Manage changesets directly from VS Code and Cursor. Manual, AI-powered, or empty changesets in one command.",
    status: "live" as const,
    link: "https://open-vsx.org/extension/GreatSoftwareLLC/vscode-changesets",
    linkText: "View on Open VSX →",
  },
  {
    title: "Meld",
    description: "A couples app focused on closeness, where matching on what you both want takes the pressure off. Two people. One toggle. Zero rejection.",
    status: "coming-soon" as const,
  },
];

const steps = [
  { t: "Build", d: "Start with the actual problem, not a feature list. Build the smallest version that proves the idea is real, and get it working end to end before any polish goes on." },
  { t: "Ship", d: "Put it in front of real users and real production load, where the rough edges actually show. Then refine the parts people touch most — the flows, the speed, and the small moments that decide whether they trust it." },
  { t: "Support", d: "Stand behind what ships and keep it healthy as it grows, fixing and tuning as real usage reveals what matters. When a project is ready to stand on its own, hand it off cleanly with everything documented." },
];
---
<Layout>
  <AlpenglowHero />

  <!-- The work -->
  <section id="services" class="mx-auto max-w-6xl px-6 py-12 scroll-mt-20">
    <h2 class="text-3xl mb-3">The work</h2>
    <p class="text-muted max-w-2xl mb-8">An independent studio with a deliberately wide range. The common thread isn't one product or one market, it's range, and doing each kind of work well.</p>
    <div class="grid gap-6 md:grid-cols-2">
      {services.map((s) => (
        <article class="group rounded-xl border border-line bg-paper p-6 transition-colors duration-200 hover:border-accent flex flex-col gap-3">
          <span class="font-mono text-sm text-accent">{s.k}</span>
          <h3 class="text-xl m-0">{s.t}</h3>
          <p class="text-muted m-0">{s.d}</p>
          <a href="/contact" class="font-mono text-sm text-accent mt-auto pt-2 no-underline group-hover:underline">{s.cta} →</a>
        </article>
      ))}
    </div>
  </section>

  <!-- Products -->
  <section id="products" class="mx-auto max-w-6xl px-6 py-12 scroll-mt-20">
    <h2 class="text-3xl mb-8">Products &amp; ventures</h2>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {products.map((p) => <ProductCard {...p} />)}
    </div>
  </section>

  <!-- How it works -->
  <section class="mx-auto max-w-6xl px-6 py-16">
    <h2 class="text-3xl mb-8">How it works</h2>
    <div class="grid gap-8 sm:grid-cols-3">
      {steps.map((s, i) => (
        <div class="flex flex-col gap-2">
          <span class="font-mono text-sm text-accent">0{i + 1}</span>
          <h3 class="text-xl">{s.t}</h3>
          <p class="text-muted m-0">{s.d}</p>
        </div>
      ))}
    </div>
    <a href="/about" class="inline-block mt-8 font-mono text-sm text-accent">Read more about the studio →</a>
  </section>
</Layout>
