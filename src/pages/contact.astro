---
import Layout from "../layouts/Layout.astro";
import { site } from "../config/site";
---
<Layout title="Contact" description="Get in touch with Great Software.">
  <section class="mx-auto max-w-6xl px-6 pt-24 pb-16">
    <div class="max-w-3xl">
      <p class="font-mono text-sm text-accent mb-4">Contact</p>
      <h1 class="text-4xl md:text-5xl tracking-tight">Let's talk.</h1>
      <p class="mt-6 text-lg text-muted max-w-xl">Have a product idea, an agentic systems project, or a problem worth solving? Reach out directly.</p>

      <div class="mt-10 max-w-xl rounded-xl border border-line bg-paper p-6 sm:p-8">
        <a href={site.mailHref}
           class="inline-block rounded-lg bg-accent px-5 py-3 font-mono text-sm text-accent-ink no-underline hover:no-underline hover:opacity-90 transition-opacity duration-200">
          Email the studio →
        </a>
        <dl class="mt-7 flex flex-col gap-5 sm:flex-row sm:gap-12">
          <div>
            <dt class="font-mono text-xs uppercase tracking-wider text-muted">Email</dt>
            <dd class="m-0 mt-1 text-lg"><a href={site.mailHref}>{site.email}</a></dd>
          </div>
          <div>
            <dt class="font-mono text-xs uppercase tracking-wider text-muted">Phone</dt>
            <dd class="m-0 mt-1 text-lg"><a href={site.phoneHref}>{site.phone}</a></dd>
          </div>
        </dl>
      </div>
    </div>
  </section>
</Layout>
