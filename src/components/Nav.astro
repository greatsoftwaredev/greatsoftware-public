---
import Logo from "./Logo.astro";
const links = [
  { href: "/#products", label: "Products" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];
---
<header class="sticky top-0 z-30 backdrop-blur-sm bg-paper/80 border-b border-line">
  <nav aria-label="Main" class="mx-auto max-w-6xl px-6 h-16 flex items-center justify-between">
    <a href="/" class="no-underline hover:no-underline"><Logo /></a>
    <div class="flex items-center gap-4">
      <ul class="flex items-center gap-6 list-none m-0 p-0">
        {links.map((l) => (
          <li>
            <a href={l.href}
               class="inline-block py-2 font-mono text-sm text-muted hover:text-ink no-underline hover:no-underline transition-colors duration-200">
              {l.label}
            </a>
          </li>
        ))}
      </ul>
      <button type="button" data-theme-toggle data-mode="auto" aria-label="Toggle theme"
              class="inline-flex items-center justify-center -mr-1 p-2 rounded-md text-muted hover:text-ink transition-colors duration-200 cursor-pointer">
        <svg data-icon="auto" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <circle cx="12" cy="12" r="8.2"/>
          <path d="M12 3.8a8.2 8.2 0 0 0 0 16.4z" fill="currentColor" stroke="none"/>
        </svg>
        <svg data-icon="light" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          <circle cx="12" cy="12" r="4.2"/>
          <path d="M12 2.6v2.1M12 19.3v2.1M21.4 12h-2.1M4.7 12H2.6M18.4 5.6l-1.5 1.5M7.1 16.9l-1.5 1.5M18.4 18.4l-1.5-1.5M7.1 7.1 5.6 5.6"/>
        </svg>
        <svg data-icon="dark" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.2 14.6A8 8 0 0 1 9.4 3.8 7 7 0 1 0 20.2 14.6z"/>
        </svg>
      </button>
    </div>
  </nav>
</header>
<script is:inline>window.gsTheme && window.gsTheme.wire();</script>
