---
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";
const links = [
  { href: "/#products", label: "Products" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];
---
<!-- backdrop-blur only from sm up: a backdrop-filter ancestor would become the
     containing block for the mobile overlay's position:fixed, trapping it in the
     header. Desktop keeps the frosted bar; the overlay is sm:hidden there. -->
<header class="sticky top-0 z-30 bg-paper/80 sm:backdrop-blur-sm border-b border-line">
  <nav aria-label="Main" class="mx-auto max-w-6xl px-6 h-16 flex items-center justify-between">
    <!-- z-50 keeps the wordmark above the mobile overlay; whitespace-nowrap stops
         "Great Software" from wrapping to two lines on narrow screens. -->
    <a href="/" class="relative z-50 no-underline hover:no-underline whitespace-nowrap"><Logo /></a>

    <!-- Desktop: inline links + toggle (hidden on phones) -->
    <div class="hidden sm:flex items-center gap-4">
      <ul class="flex items-center gap-6 list-none m-0 p-0">
        {links.map((l) => (
          <li>
            <a href={l.href}
               class="inline-block py-2 font-mono text-sm text-muted hover:text-ink no-underline hover:no-underline transition-colors duration-200">
              {l.label}
            </a>
          </li>
        ))}
      </ul>
      <ThemeToggle class="-mr-1 p-2" />
    </div>

    <!-- Mobile: full-screen overlay menu. Built on <details> so it works without
         JS (native toggle + button semantics); the script below adds ESC-to-close,
         close-on-tap, and scroll-lock. -->
    <details data-mobile-nav class="sm:hidden">
      <summary aria-label="Menu"
               class="menu-summary relative z-50 inline-flex items-center justify-center -mr-1 p-2 rounded-md text-muted hover:text-ink cursor-pointer">
        <svg class="menu-bars" aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <svg class="menu-x" aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </summary>
      <div class="menu-overlay fixed inset-0 z-40 bg-paper flex-col items-center justify-center gap-10">
        <ul class="flex flex-col items-center gap-7 list-none m-0 p-0">
          {links.map((l) => (
            <li>
              <a href={l.href}
                 class="font-mono text-xl text-muted hover:text-ink no-underline hover:no-underline transition-colors duration-200">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
        <ThemeToggle label class="p-2 text-base" />
      </div>
    </details>
  </nav>
</header>

<style>
  /* drop the default disclosure triangle */
  .menu-summary { list-style: none; }
  .menu-summary::-webkit-details-marker { display: none; }
  .menu-summary::marker { content: ""; }
  /* icon swap: bars when closed, X when open */
  .menu-x { display: none; }
  details[open] .menu-bars { display: none; }
  details[open] .menu-x { display: block; }
  /* overlay hidden until open (then it's a flex column) */
  .menu-overlay { display: none; }
  details[open] .menu-overlay { display: flex; }
</style>

<script is:inline>
  (function () {
    if (window.gsTheme && window.gsTheme.wire) window.gsTheme.wire();
    var d = document.querySelector("details[data-mobile-nav]");
    if (!d) return;
    function close() { d.removeAttribute("open"); }
    // lock background scroll while the overlay is open
    d.addEventListener("toggle", function () {
      document.body.style.overflow = d.open ? "hidden" : "";
    });
    // close after picking a link (covers same-page #anchors that don't reload)
    d.querySelectorAll(".menu-overlay a").forEach(function (a) {
      a.addEventListener("click", close);
    });
    // ESC closes
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && d.open) close();
    });
    // if the viewport grows past the mobile breakpoint, make sure we're closed
    var mq = matchMedia("(min-width: 640px)");
    mq.addEventListener("change", function () {
      if (mq.matches) { close(); document.body.style.overflow = ""; }
    });
  })();
</script>
