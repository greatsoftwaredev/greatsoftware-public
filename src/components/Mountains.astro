---
// Two fixed layers that frame the page:
//   1. A single soft atmospheric gradient covering the whole viewport. It glows
//      warm near the horizon (strength from --tod / the visitor's local time)
//      and fades smoothly up to a cool daylight sky — one continuous blend, no
//      hard seam anywhere.
//   2. A foreground mountain band pinned to the bottom of the viewport. Page
//      content scrolls UP behind it; the body reserves --mtn-h of bottom padding
//      so the final content clears above the peaks at the end of the scroll.
---
<!-- 1. full-page glow, behind all content -->
<div data-backdrop aria-hidden="true"
     class="pointer-events-none fixed inset-0 -z-10"
     style="background: linear-gradient(180deg,
       color-mix(in srgb, var(--color-sky) 50%, var(--color-paper)) 0%,
       var(--color-paper) 40%,
       color-mix(in srgb, var(--color-accent) calc(var(--tod, 0.4) * 14%), var(--color-paper)) 72%,
       color-mix(in srgb, var(--color-accent) calc(var(--tod, 0.4) * 28%), var(--color-paper)) 100%);">
</div>

<!-- 2. foreground mountain band; content scrolls behind it -->
<div aria-hidden="true"
     class="pointer-events-none fixed inset-x-0 bottom-0 z-10 overflow-hidden"
     style="height: var(--mtn-h);">
  <svg class="absolute inset-0 h-full w-full" viewBox="0 0 1440 400"
       preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <path fill="var(--color-ridge-1)" d="M0 232 L240 150 L470 214 L720 132 L980 208 L1230 140 L1440 200 L1440 400 L0 400 Z"/>
    <path fill="var(--color-ridge-2)" d="M0 282 L240 216 L470 282 L720 200 L980 280 L1240 216 L1440 262 L1440 400 L0 400 Z"/>
    <path fill="var(--color-ridge-3)" d="M0 332 L260 272 L520 332 L780 262 L1040 332 L1300 272 L1440 312 L1440 400 L0 400 Z"/>
    <path fill="var(--color-ridge-4)" d="M0 382 L320 332 L600 382 L880 332 L1160 382 L1440 346 L1440 400 L0 400 Z"/>
  </svg>
</div>
