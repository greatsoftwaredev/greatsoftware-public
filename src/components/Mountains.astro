---
// Backdrop = two crossfading scenes plus a mountain band, all in one fixed
// container behind the page (-z-10), so content scrolls cleanly on top.
//
//   • Day scene  — soft warm-to-cool glow driven by --tod (time of day).
//   • Night scene — deep sky, a star field, and a moon; shown when <html>.night.
//
// A soft white backlight traces the whole skyline: a blurred copy of the
// topmost ridge outline sits behind the opaque foreground mountains, so the
// entire ridge edge reads as rim-lit / back-lit.
//
// The <head> controller toggles .night and sets --tod from the visitor's local
// time (or a localStorage / gsGlow() override). The mountain band colours come
// from the ridge tokens, which .night darkens, so the band crossfades between
// day and night via a fill transition.

// Deterministic star field (no RNG, so builds stay reproducible). Kept in the
// upper sky (y < 520) so stars sit above the mountain band.
const stars = Array.from({ length: 52 }, (_, i) => ({
  x: (i * 197 + 53) % 1440,
  y: (i * 113 + 29) % 520,
  r: 0.6 + ((i * 37) % 10) / 8,
  o: 0.35 + ((i * 53) % 9) / 14,
  twinkle: i % 6 === 0,
}));

// Procedural ridgelines: a ridged value-noise fractal so the silhouette reads
// as rugged mountains (a few dominant peaks + craggy detail) rather than smooth
// waves. Seeded, so it's identical on every build.
function mulberry32(a: number) {
  return function () {
    a |= 0; a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
function makeNoise(seed: number) {
  const rnd = mulberry32(seed);
  const N = 256;
  const g: number[] = [];
  for (let i = 0; i < N; i++) g.push(rnd());
  const smooth = (t: number) => t * t * (3 - 2 * t);
  return (x: number) => {
    const i = Math.floor(x);
    const f = x - i;
    const a = g[((i % N) + N) % N];
    const b = g[(((i + 1) % N) + N) % N];
    return a + smooth(f) * (b - a);
  };
}
function ridgeYs(
  seed: number, pts: number, peakY: number, valleyY: number,
  octaves: number, baseFreq: number, persistence: number, sharpen: number,
) {
  const noise = makeNoise(seed);
  const hs: number[] = [];
  let maxH = 0;
  for (let p = 0; p < pts; p++) {
    const x = p / (pts - 1);
    let h = 0, amp = 1, freq = baseFreq, sum = 0;
    for (let o = 0; o < octaves; o++) {
      const n = noise(x * freq + o * 17.3);
      const r = 1 - Math.abs(2 * n - 1); // ridged: sharp crest where n≈0.5
      h += amp * r; sum += amp; amp *= persistence; freq *= 2;
    }
    h = Math.pow(h / sum, sharpen); // deepen valleys, sharpen crests
    hs.push(h);
    if (h > maxH) maxH = h;
  }
  return hs.map((h) => valleyY - (h / maxH) * (valleyY - peakY));
}
function buildPath(ys: number[]) {
  const W = 1440, pts = ys.length;
  let d = "";
  for (let q = 0; q < pts; q++) {
    const xx = ((q / (pts - 1)) * W).toFixed(1);
    d += (q === 0 ? "M" : "L") + xx + " " + ys[q].toFixed(1) + " ";
  }
  return d + "L" + W + " 400 L0 400 Z";
}

const PTS = 200; // shared x-grid so the ranges combine into one skyline
const layers = [
  // far range: tall, sharp, most detail → near foothills: lower and gentler
  { fill: "var(--color-ridge-1)", ys: ridgeYs(1207, PTS, 48, 216, 6, 2.6, 0.56, 1.7) },
  { fill: "var(--color-ridge-2)", ys: ridgeYs(5519, PTS, 146, 286, 6, 3.2, 0.56, 1.5) },
  { fill: "var(--color-ridge-3)", ys: ridgeYs(8831, PTS, 238, 336, 5, 4.0, 0.55, 1.34) },
  { fill: "var(--color-ridge-4)", ys: ridgeYs(3344, PTS, 322, 388, 5, 4.8, 0.54, 1.22) },
];
const ridges = layers.map((l) => ({ fill: l.fill, d: buildPath(l.ys) }));
// skyline = topmost outline across all ranges (the edge that gets back-lit)
const skyline = buildPath(layers[0].ys.map((_, i) => Math.min(...layers.map((l) => l.ys[i]))));
---
<!-- BACKDROP — sky, stars, moon, and the mountain band, all behind page content.
     One fixed container, anchored to the top at a STABLE large-viewport height
     (100lvh), so the mobile URL bar reveals/hides the mountains instead of
     resizing + snapping them on scroll. Sits at -z-10 so content scrolls cleanly
     on top (the mountains never cover cards). overflow-hidden crops the sides so
     the silhouette below keeps its true shape and is sliced, not squished. -->
<div data-backdrop aria-hidden="true"
     class="pointer-events-none fixed top-0 left-0 w-full -z-10 overflow-hidden"
     style="height: 100vh; height: 100lvh;">
  <!-- day glow -->
  <div data-glow-day class="absolute inset-0"
       style="background: linear-gradient(180deg,
         color-mix(in srgb, var(--color-sky) 50%, var(--color-paper)) 0%,
         var(--color-paper) 40%,
         color-mix(in srgb, var(--color-accent) calc(var(--tod, 0.4) * 14%), var(--color-paper)) 72%,
         color-mix(in srgb, var(--color-accent) calc(var(--tod, 0.4) * 28%), var(--color-paper)) 100%);"></div>

  <!-- night sky + stars + moon -->
  <div data-glow-night class="absolute inset-0"
       style="background: linear-gradient(180deg, #060A12 0%, #0A111E 42%, #101A2B 72%, #16243A 100%);">
    <svg class="absolute inset-0 h-full w-full" viewBox="0 0 1440 900"
         preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
      {stars.map((s) => (
        <circle cx={s.x} cy={s.y} r={s.r} fill="#EAF0FB" opacity={s.o}
                class={s.twinkle ? "twinkle" : undefined} />
      ))}
    </svg>
    <!-- moon: its own element (not in the sliced star SVG) so it stays on-screen
         at any width — upper-right on desktop and mobile alike. -->
    <div data-glow-moon class="absolute"
         style="top: 8%; right: 9%; width: clamp(170px, 30vw, 300px); aspect-ratio: 1;
           background: radial-gradient(circle,
             rgba(205,214,230,0.45) 0%, rgba(205,214,230,0.10) 32%, transparent 62%);">
      <div class="absolute rounded-full"
           style="top: 50%; left: 50%; width: 25%; aspect-ratio: 1;
             transform: translate(-50%, -50%); background: #EEF1F8;"></div>
    </div>
  </div>

  <!-- backlight: blurred skyline outline, glows up along the whole ridge edge.
       Same width/centering as the foreground band so the rim stays aligned. -->
  <svg class="absolute bottom-0 left-1/2 -translate-x-1/2"
       style="width: max(100%, 1440px); height: var(--mtn-h); overflow: visible;"
       viewBox="0 0 1440 400" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <filter id="skyHaloWide" x="-25%" y="-320%" width="150%" height="600%">
        <feGaussianBlur stdDeviation="34 96"/>
      </filter>
      <filter id="skyHalo" x="-18%" y="-180%" width="136%" height="380%">
        <feGaussianBlur stdDeviation="18 50"/>
      </filter>
      <filter id="skyRim" x="-12%" y="-90%" width="124%" height="240%">
        <feGaussianBlur stdDeviation="6 16"/>
      </filter>
    </defs>
    <path d={skyline} fill="rgba(255,253,247,0.20)" filter="url(#skyHaloWide)"/>
    <path d={skyline} fill="rgba(255,253,247,0.22)" filter="url(#skyHalo)"/>
    <path d={skyline} fill="rgba(255,254,250,0.42)" filter="url(#skyRim)"/>
  </svg>

  <!-- foreground mountain band. Held at >= the viewBox width and centered, so on
       narrow screens it overflows (cropped by the container) and keeps its true
       proportions instead of squishing. Painted after the backlight so the rim
       reads only above the ridgeline. -->
  <svg class="absolute bottom-0 left-1/2 -translate-x-1/2"
       style="width: max(100%, 1440px); height: var(--mtn-h);"
       viewBox="0 0 1440 400" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    {ridges.map((r) => <path fill={r.fill} d={r.d} />)}
  </svg>
</div>
