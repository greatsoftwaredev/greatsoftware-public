---
// Backdrop = two crossfading scenes behind the page, plus a fixed foreground
// mountain band that content scrolls behind.
//
//   • Day scene  — soft warm-to-cool glow driven by --tod (time of day).
//   • Night scene — deep sky, a star field, and a moon; shown when <html>.night.
//
// The <head> controller toggles .night and sets --tod from the visitor's local
// time (or a localStorage / gsGlow() override). The mountain band colours come
// from the ridge tokens, which .night darkens, so the same band crossfades
// between day and night via a fill transition.

// Deterministic star field (no RNG, so builds stay reproducible). Kept in the
// upper sky (y < 520) so stars sit above the mountain band.
const stars = Array.from({ length: 52 }, (_, i) => ({
  x: (i * 197 + 53) % 1440,
  y: (i * 113 + 29) % 520,
  r: 0.6 + ((i * 37) % 10) / 8,
  o: 0.35 + ((i * 53) % 9) / 14,
  twinkle: i % 6 === 0,
}));
---
<!-- BACKDROP (behind all content) -->
<div data-backdrop aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10">
  <!-- day glow -->
  <div data-glow-day class="absolute inset-0"
       style="background: linear-gradient(180deg,
         color-mix(in srgb, var(--color-sky) 50%, var(--color-paper)) 0%,
         var(--color-paper) 40%,
         color-mix(in srgb, var(--color-accent) calc(var(--tod, 0.4) * 14%), var(--color-paper)) 72%,
         color-mix(in srgb, var(--color-accent) calc(var(--tod, 0.4) * 28%), var(--color-paper)) 100%);"></div>

  <!-- night sky + stars + moon -->
  <div data-glow-night class="absolute inset-0"
       style="background: linear-gradient(180deg, #060A12 0%, #0A111E 42%, #101A2B 72%, #16243A 100%);">
    <svg class="absolute inset-0 h-full w-full" viewBox="0 0 1440 900"
         preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <radialGradient id="moonGlow" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#CDD6E6" stop-opacity="0.45"/>
          <stop offset="55%" stop-color="#CDD6E6" stop-opacity="0.10"/>
          <stop offset="100%" stop-color="#CDD6E6" stop-opacity="0"/>
        </radialGradient>
      </defs>
      <circle cx="1180" cy="195" r="155" fill="url(#moonGlow)"/>
      <circle cx="1180" cy="195" r="38" fill="#EEF1F8"/>
      {stars.map((s) => (
        <circle cx={s.x} cy={s.y} r={s.r} fill="#EAF0FB" opacity={s.o}
                class={s.twinkle ? "twinkle" : undefined} />
      ))}
    </svg>
  </div>
</div>

<!-- FOREGROUND mountain band; content scrolls behind it -->
<div data-mtn aria-hidden="true"
     class="pointer-events-none fixed inset-x-0 bottom-0 z-10 overflow-hidden"
     style="height: var(--mtn-h);">
  <svg class="absolute inset-0 h-full w-full" viewBox="0 0 1440 400"
       preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <path fill="var(--color-ridge-1)" d="M0 232 L240 150 L470 214 L720 132 L980 208 L1230 140 L1440 200 L1440 400 L0 400 Z"/>
    <path fill="var(--color-ridge-2)" d="M0 282 L240 216 L470 282 L720 200 L980 280 L1240 216 L1440 262 L1440 400 L0 400 Z"/>
    <path fill="var(--color-ridge-3)" d="M0 332 L260 272 L520 332 L780 262 L1040 332 L1300 272 L1440 312 L1440 400 L0 400 Z"/>
    <path fill="var(--color-ridge-4)" d="M0 382 L320 332 L600 382 L880 332 L1160 382 L1440 346 L1440 400 L0 400 Z"/>
  </svg>
</div>
