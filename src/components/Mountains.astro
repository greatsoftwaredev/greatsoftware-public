---
// Layers with distinct scroll behaviour:
//
//   (1)  FIXED sky gradient — the day/night background colour. Stays put.
//   (2)  SCROLLING night sky — stars + moon, absolute at the page top, so they
//        scroll up and off as you scroll down. Behind content.
//   (2b) SCROLLING day sky — sun + clouds + birds, mirror of (2). Day-only.
//   (3)  FIXED mountains + backlight glow — kept together in FRONT of content
//        (under the nav), so content scrolls up from behind the mountains.
//
// Sky elements carry data-parallax factors; a small script drifts them slower
// than the page (translateY = scroll x factor) for depth. Moon/sun are slowest
// (most distant), birds fastest. Disabled under prefers-reduced-motion.
//
//   • Day scene  — soft warm-to-cool glow driven by --tod (time of day).
//   • Night scene — deep sky, a star field, and a moon; shown when <html>.night.
//
// A soft white backlight traces the whole skyline: a blurred copy of the topmost
// ridge outline sits just behind the opaque ridges (same foreground layer), so
// the ridge edge reads as rim-lit and the glow never detaches from the mountains.
//
// The <head> controller toggles .night and sets --tod from the visitor's local
// time (or a localStorage / gsGlow() override). The mountain band colours come
// from the ridge tokens, which .night darkens, so the band crossfades between
// day and night via a fill transition.

// Deterministic star field (no RNG, so builds stay reproducible). Kept in the
// upper sky (y < 520) so stars sit above the mountain band.
const stars = Array.from({ length: 52 }, (_, i) => ({
  x: (i * 197 + 53) % 1440,
  y: (i * 113 + 29) % 520,
  r: 0.6 + ((i * 37) % 10) / 8,
  o: 0.35 + ((i * 53) % 9) / 14,
  twinkle: i % 6 === 0,
}));

// Procedural ridgelines: a ridged value-noise fractal so the silhouette reads
// as rugged mountains (a few dominant peaks + craggy detail) rather than smooth
// waves. Seeded, so it's identical on every build.
function mulberry32(a: number) {
  return function () {
    a |= 0; a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
function makeNoise(seed: number) {
  const rnd = mulberry32(seed);
  const N = 256;
  const g: number[] = [];
  for (let i = 0; i < N; i++) g.push(rnd());
  const smooth = (t: number) => t * t * (3 - 2 * t);
  return (x: number) => {
    const i = Math.floor(x);
    const f = x - i;
    const a = g[((i % N) + N) % N];
    const b = g[(((i + 1) % N) + N) % N];
    return a + smooth(f) * (b - a);
  };
}
function ridgeYs(
  seed: number, pts: number, peakY: number, valleyY: number,
  octaves: number, baseFreq: number, persistence: number, sharpen: number,
) {
  const noise = makeNoise(seed);
  const hs: number[] = [];
  let maxH = 0;
  for (let p = 0; p < pts; p++) {
    const x = p / (pts - 1);
    let h = 0, amp = 1, freq = baseFreq, sum = 0;
    for (let o = 0; o < octaves; o++) {
      const n = noise(x * freq + o * 17.3);
      const r = 1 - Math.abs(2 * n - 1); // ridged: sharp crest where n≈0.5
      h += amp * r; sum += amp; amp *= persistence; freq *= 2;
    }
    h = Math.pow(h / sum, sharpen); // deepen valleys, sharpen crests
    hs.push(h);
    if (h > maxH) maxH = h;
  }
  return hs.map((h) => valleyY - (h / maxH) * (valleyY - peakY));
}
function buildPath(ys: number[]) {
  const W = 1440, pts = ys.length;
  let d = "";
  for (let q = 0; q < pts; q++) {
    const xx = ((q / (pts - 1)) * W).toFixed(1);
    d += (q === 0 ? "M" : "L") + xx + " " + ys[q].toFixed(1) + " ";
  }
  return d + "L" + W + " 400 L0 400 Z";
}

const PTS = 200; // shared x-grid so the ranges combine into one skyline
const layers = [
  // far range: tall, sharp, most detail → near foothills: lower and gentler
  { fill: "var(--color-ridge-1)", ys: ridgeYs(1207, PTS, 48, 216, 6, 2.6, 0.56, 1.7) },
  { fill: "var(--color-ridge-2)", ys: ridgeYs(5519, PTS, 146, 286, 6, 3.2, 0.56, 1.5) },
  { fill: "var(--color-ridge-3)", ys: ridgeYs(8831, PTS, 238, 336, 5, 4.0, 0.55, 1.34) },
  { fill: "var(--color-ridge-4)", ys: ridgeYs(3344, PTS, 322, 388, 5, 4.8, 0.54, 1.22) },
];
const ridges = layers.map((l) => ({ fill: l.fill, d: buildPath(l.ys) }));
// skyline = topmost outline across all ranges (the edge that gets back-lit)
const skyline = buildPath(layers[0].ys.map((_, i) => Math.min(...layers.map((l) => l.ys[i]))));

// Day-sky clouds: soft drifting blobs. `p` = parallax factor (slower than the
// page = more distant); `dur` = drift speed. Each is a parallax wrapper (vertical
// scroll-lag) around a drifting blob, so the two transforms don't collide.
const clouds = [
  { top: "15%", left: "6%",  w: "clamp(170px, 28vw, 320px)", dur: "95s",  op: 0.7,  p: 0.4 },
  { top: "27%", left: "60%", w: "clamp(130px, 22vw, 250px)", dur: "130s", op: 0.5,  p: 0.34 },
  { top: "41%", left: "28%", w: "clamp(110px, 18vw, 210px)", dur: "78s",  op: 0.4,  p: 0.46 },
];
---
<!-- (1) FIXED sky gradient (day <-> night). Stays put while the page scrolls;
     stable large-viewport height (100lvh) so the mobile URL bar doesn't make it
     resize + snap. Backmost (-z-20), behind content and the scrolling sky. -->
<div data-backdrop aria-hidden="true"
     class="pointer-events-none fixed top-0 left-0 w-full -z-20 overflow-hidden"
     style="height: 100vh; height: 100lvh;">
  <div data-glow-day class="absolute inset-0"
       style="background: linear-gradient(180deg,
         color-mix(in srgb, var(--color-sky) 50%, var(--color-paper)) 0%,
         var(--color-paper) 40%,
         color-mix(in srgb, var(--color-accent) calc(var(--tod, 0.4) * 14%), var(--color-paper)) 72%,
         color-mix(in srgb, var(--color-accent) calc(var(--tod, 0.4) * 28%), var(--color-paper)) 100%);"></div>
  <div data-glow-night class="absolute inset-0"
       style="background: linear-gradient(180deg, #060A12 0%, #0A111E 42%, #101A2B 72%, #16243A 100%);"></div>
</div>

<!-- (2) SCROLLING night sky — stars + moon. absolute (not fixed) at the page top,
     so they scroll up and off as the page scrolls. Behind content (-z-10), in
     front of the fixed gradient. Night-only (crossfades via data-glow-night). -->
<div data-glow-night aria-hidden="true"
     class="pointer-events-none absolute top-0 left-0 w-full -z-10 overflow-hidden"
     style="height: 100vh;">
  <svg data-parallax="0.28" class="absolute inset-0 h-full w-full" viewBox="0 0 1440 900"
       preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
    {stars.map((s) => (
      <circle cx={s.x} cy={s.y} r={s.r} fill="#EAF0FB" opacity={s.o}
              class={s.twinkle ? "twinkle" : undefined} />
    ))}
  </svg>
  <!-- moon: its own element (not in the sliced star SVG) so it stays on-screen at
       any width — upper-right on desktop and mobile alike. Slowest parallax = most distant. -->
  <div data-glow-moon data-parallax="0.5" class="absolute"
       style="top: 8%; right: 9%; width: clamp(170px, 30vw, 300px); aspect-ratio: 1;
         background: radial-gradient(circle,
           rgba(205,214,230,0.45) 0%, rgba(205,214,230,0.10) 32%, transparent 62%);">
    <div class="absolute rounded-full"
         style="top: 50%; left: 50%; width: 25%; aspect-ratio: 1;
           transform: translate(-50%, -50%); background: #EEF1F8;"></div>
  </div>
</div>

<!-- (2b) SCROLLING day sky — sun, clouds, birds. Mirrors the night layer: shown by
     day (crossfades via data-glow-day), scrolls off, behind content. All tinted by
     --tod so they warm toward terracotta at dawn/dusk. -->
<div data-glow-day aria-hidden="true"
     class="pointer-events-none absolute top-0 left-0 w-full -z-10 overflow-hidden"
     style="height: 100vh;">
  <!-- sun: warm disc + halo; tint deepens toward terracotta as --tod rises (dawn/dusk) -->
  <div data-parallax="0.5" class="absolute"
       style="top: 9%; right: 10%; width: clamp(150px, 26vw, 260px); aspect-ratio: 1;
         background: radial-gradient(circle,
           color-mix(in srgb, var(--color-accent) calc(var(--tod, 0.4) * 22%), #FFF5E6) 0%,
           color-mix(in srgb, var(--color-accent) calc(var(--tod, 0.4) * 28%), rgba(255,245,230,0.30)) 28%,
           transparent 64%);">
    <div class="absolute rounded-full"
         style="top: 50%; left: 50%; width: 34%; aspect-ratio: 1; transform: translate(-50%, -50%);
           background: color-mix(in srgb, var(--color-accent) calc(var(--tod, 0.4) * 45%), #FFF3DC);"></div>
  </div>

  <!-- clouds: parallax wrapper (vertical scroll-lag) around a drifting blob -->
  {clouds.map((c) => (
    <div data-parallax={c.p} class="absolute" style={`top:${c.top}; left:${c.left}; width:${c.w};`}>
      <div class="gs-cloud" style={`aspect-ratio: 5 / 2; opacity:${c.op}; animation-duration:${c.dur};
        background: radial-gradient(ellipse closest-side,
          color-mix(in srgb, var(--color-accent) calc(var(--tod, 0.4) * 9%), #FFFFFF) 0%,
          color-mix(in srgb, var(--color-accent) calc(var(--tod, 0.4) * 7%), rgba(255,255,255,0.55)) 46%,
          transparent 72%);`} />
    </div>
  ))}

  <!-- birds: a small distant flock above the peaks (ink silhouette on the day sky) -->
  <svg data-parallax="0.22" class="absolute" style="top: 38%; left: 56%; width: clamp(64px, 11vw, 110px);"
       viewBox="0 0 100 40" fill="none" stroke="var(--color-ink)" stroke-width="2.2"
       stroke-linecap="round" opacity="0.45" xmlns="http://www.w3.org/2000/svg">
    <path d="M6 15 Q12 8 18 15 Q24 8 30 15"/>
    <path d="M41 8 Q48 1 55 8 Q62 1 69 8"/>
    <path d="M63 23 Q69 17 75 23 Q81 17 87 23"/>
  </svg>
</div>

<!-- (3) FIXED foreground — the mountain band and its backlight glow, kept TOGETHER
     in front of content (z-10, under the z-30 nav) so content scrolls up from
     behind the mountains. Grouping the glow with the ridges is the fix for the old
     bug where the glow sat behind the cards while the ridges sat in front.
     Held at >= the viewBox width and centered, so narrow screens crop a true-shape
     slice (via overflow-hidden) instead of squishing. -->
<!-- Anchored bottom-0 (not top-0): the ridge stays pinned to the *visible*
     viewport bottom, so it glides with the mobile URL bar instead of dropping
     below the fold + popping back when the bar hides. Height stays a stable
     100lvh so the band doesn't resize and the glow keeps its upward room. -->
<div data-mtn aria-hidden="true"
     class="pointer-events-none fixed bottom-0 left-0 w-full z-10 overflow-hidden"
     style="height: 100vh; height: 100lvh;">
  <!-- backlight: blurred skyline outline, glows up along the whole ridge edge.
       Same width/centering as the band below so the rim stays aligned. -->
  <svg class="absolute bottom-0 left-1/2 -translate-x-1/2"
       style="width: max(100%, 1440px); height: var(--mtn-h); overflow: visible;"
       viewBox="0 0 1440 400" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <filter id="skyHaloWide" x="-25%" y="-320%" width="150%" height="600%">
        <feGaussianBlur stdDeviation="34 96"/>
      </filter>
      <filter id="skyHalo" x="-18%" y="-180%" width="136%" height="380%">
        <feGaussianBlur stdDeviation="18 50"/>
      </filter>
      <filter id="skyRim" x="-12%" y="-90%" width="124%" height="240%">
        <feGaussianBlur stdDeviation="6 16"/>
      </filter>
    </defs>
    <path d={skyline} fill="rgba(255,253,247,0.20)" filter="url(#skyHaloWide)"/>
    <path d={skyline} fill="rgba(255,253,247,0.22)" filter="url(#skyHalo)"/>
    <path d={skyline} fill="rgba(255,254,250,0.42)" filter="url(#skyRim)"/>
  </svg>

  <!-- the opaque ridge band; painted after the backlight so the rim reads only
       above the ridgeline. -->
  <svg class="absolute bottom-0 left-1/2 -translate-x-1/2"
       style="width: max(100%, 1440px); height: var(--mtn-h);"
       viewBox="0 0 1440 400" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    {ridges.map((r) => <path fill={r.fill} d={r.d} />)}
  </svg>
</div>

<!-- Parallax: sky elements drift slower than the page (translateY = scroll x factor)
     for depth. rAF-throttled, passive, and skipped under reduced-motion. Factors
     live on each element's data-parallax (moon/sun slowest → birds fastest). -->
<script is:inline>
  (function () {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    var els = [].slice.call(document.querySelectorAll("[data-parallax]"));
    if (!els.length) return;
    var ticking = false;
    function update() {
      var y = window.scrollY || window.pageYOffset || 0;
      for (var i = 0; i < els.length; i++) {
        var f = parseFloat(els[i].getAttribute("data-parallax")) || 0;
        els[i].style.transform = "translate3d(0," + (y * f).toFixed(1) + "px,0)";
      }
      ticking = false;
    }
    function onScroll() { if (!ticking) { ticking = true; requestAnimationFrame(update); } }
    window.addEventListener("scroll", onScroll, { passive: true });
    update();
  })();
</script>
