---
import { site } from "../config/site";
import Logo from "./Logo.astro";
const year = new Date().getFullYear();
---
<footer class="mt-32 border-t border-line">
  <div class="mx-auto max-w-6xl px-6 py-12 flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
    <Logo />
    <ul class="flex flex-wrap gap-x-6 gap-y-2 list-none m-0 p-0 font-mono text-sm">
      <li><a href="/about" class="inline-block py-2 text-muted hover:text-ink no-underline">About</a></li>
      <li><a href="/privacy" class="inline-block py-2 text-muted hover:text-ink no-underline">Privacy</a></li>
      <li><a href="/terms" class="inline-block py-2 text-muted hover:text-ink no-underline">Terms</a></li>
      <li><a href={site.mailHref} class="inline-block py-2 text-muted hover:text-ink no-underline">{site.email}</a></li>
    </ul>
  </div>
  <p class="mx-auto max-w-6xl px-6 pb-10 text-xs text-muted font-mono">© {year} {site.name}</p>
</footer>
