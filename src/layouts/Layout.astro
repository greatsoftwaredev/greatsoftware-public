---
import "../styles/global.css";
import { site } from "../config/site";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Mountains from "../components/Mountains.astro";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = site.name,
  description = site.oneLiner,
} = Astro.props;
const fullTitle = title === site.name ? `${site.name} — ${site.tagline}` : `${title} — ${site.name}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Work+Sans:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" />
    <!--
      Theme + alpenglow controller (runs before paint).
      Resolution order:
        1. localStorage "gs-glow" override (set by the nav toggle or gsGlow()):
             "light"  -> day scene, glow follows the hour
             "dark"   -> night scene
             "dawn"|"day"|"dusk"|"night" -> lock to that preset
             "cycle"  -> loop night -> dawn -> day -> dusk
             number 0..1 -> lock to a custom glow intensity
             unset / "auto" -> step 2
        2. OS preference (prefers-color-scheme): dark -> night; light -> day with
           the hour's glow.
        3. No OS preference -> our local-time clock (day glows + night at night).
      Toggle cycles auto -> light -> dark. Cycle speed: "gs-glow-interval" (ms,
      default 30000). User actions fade quickly; ambient drift uses ~2.5s.
      Console API: gsGlow.day() / .night() / .cycle() / .auto() … (gsGlow.help()).
    -->
    <script is:inline>
      (function () {
        var KEY = "gs-glow", INT_KEY = "gs-glow-interval";
        var root = document.documentElement;
        var mqDark = matchMedia("(prefers-color-scheme: dark)");
        var mqLight = matchMedia("(prefers-color-scheme: light)");
        var PRESETS = {
          dawn:  { tod: 0.8,  night: false },
          day:   { tod: 0.3,  night: false },
          dusk:  { tod: 0.9,  night: false },
          night: { tod: 0.15, night: true  }
        };
        var CYCLE = ["night", "dawn", "day", "dusk"];
        var timer = null, fadeTimer = null;

        function ls(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
        function setLS(v) { try { (v == null) ? localStorage.removeItem(KEY) : localStorage.setItem(KEY, v); } catch (e) {} }

        function applyState(s, fast) {
          if (fast) {
            root.setAttribute("data-fade", "fast");
            clearTimeout(fadeTimer);
            fadeTimer = setTimeout(function () { root.removeAttribute("data-fade"); }, 2200);
          }
          root.style.setProperty("--tod", String(s.tod));
          root.classList.toggle("night", !!s.night);
          updateToggle();
        }

        function dayGlow() {            // light mode: glow follows the hour, never night
          var h = new Date().getHours();
          if (h >= 5 && h < 9)  return { tod: 0.8, night: false };
          if (h >= 9 && h < 16) return { tod: 0.3, night: false };
          if (h >= 16 && h < 20) return { tod: 0.9, night: false };
          return { tod: 0.2, night: false };
        }
        function clockState() {         // full auto: includes the night scene
          var h = new Date().getHours();
          if (h >= 5 && h < 9)  return PRESETS.dawn;
          if (h >= 9 && h < 16) return PRESETS.day;
          if (h >= 16 && h < 20) return PRESETS.dusk;
          return PRESETS.night;
        }
        function osState() {
          if (mqDark.matches)  return PRESETS.night;   // OS dark  -> night
          if (mqLight.matches) return dayGlow();        // OS light -> day, glow by hour
          return clockState();                          // no preference -> our clock
        }
        function resolve(pref) {
          if (pref === "dark")  return PRESETS.night;
          if (pref === "light") return dayGlow();
          if (pref && PRESETS[pref]) return PRESETS[pref];
          if (pref && !isNaN(parseFloat(pref))) return { tod: Math.max(0, Math.min(1, parseFloat(pref))), night: false };
          return osState();                             // auto / unset
        }

        function apply(fast) {
          if (timer) { clearInterval(timer); timer = null; }
          var pref = ls(KEY);
          var reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
          if (pref === "cycle" && !reduce) {
            var i = 0, ms = parseInt(ls(INT_KEY), 10) || 30000;
            applyState(PRESETS[CYCLE[0]], fast);
            timer = setInterval(function () { i = (i + 1) % CYCLE.length; applyState(PRESETS[CYCLE[i]]); }, ms);
          } else {
            applyState(resolve(pref), fast);
          }
        }

        // ---- nav theme toggle (auto -> light -> dark) ----
        function currentMode() {
          var p = ls(KEY);
          if (p === "light") return "light";
          if (p === "dark" || p === "night") return "dark";
          if (!p || p === "auto") return "auto";
          return "light";                               // dawn/day/dusk/number/cycle -> light-ish
        }
        function updateToggle() {
          var btn = document.querySelector("[data-theme-toggle]");
          if (!btn) return;
          var m = currentMode();
          btn.setAttribute("data-mode", m);
          var label = m === "auto" ? "Theme: auto (match system)" : m === "light" ? "Theme: light" : "Theme: dark";
          btn.setAttribute("aria-label", label);
          btn.setAttribute("title", label);
        }
        function cycleMode() {
          var order = ["auto", "light", "dark"];
          setLS((function (n) { return n === "auto" ? null : n; })(order[(order.indexOf(currentMode()) + 1) % order.length]));
          apply(true);                                  // user action -> snappy fade
        }
        function wire() {
          var btn = document.querySelector("[data-theme-toggle]");
          if (btn && !btn.hasAttribute("data-wired")) { btn.setAttribute("data-wired", "1"); btn.addEventListener("click", cycleMode); }
          updateToggle();
        }

        // Console API — type `gsGlow` to see the methods, or gsGlow.help().
        function pick(v) { setLS((v == null || v === "auto") ? null : String(v)); apply(true); }
        window.gsGlow = {
          auto:  function () { pick("auto"); },   // follow OS / local time (default)
          light: function () { pick("light"); },  // day scene, glow follows the hour
          dark:  function () { pick("dark"); },    // night scene
          dawn:  function () { pick("dawn"); },    // locked warm sunrise glow
          day:   function () { pick("day"); },     // locked bright midday glow
          dusk:  function () { pick("dusk"); },    // locked golden-hour glow
          night: function () { pick("night"); },   // locked night scene
          cycle: function () { pick("cycle"); },   // loop night -> dawn -> day -> dusk
          set:   function (n) { pick(n); },         // custom glow intensity, 0..1
          help:  function () {
            console.log("gsGlow: .auto() .light() .dark() .dawn() .day() .dusk() .night() .cycle() .set(0..1)");
            return "theme controls";
          }
        };
        window.gsTheme = { cycle: cycleMode, wire: wire };
        console.log("%c⛰ gsGlow", "color:#C04F2B;font-weight:600", "— theme playground, try gsGlow.help()");

        // follow OS scheme changes while in auto (ambient / slow)
        function onOS() { if (currentMode() === "auto") apply(); }
        if (mqDark.addEventListener) { mqDark.addEventListener("change", onOS); mqLight.addEventListener("change", onOS); }

        if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", wire); else wire();

        apply();   // initial (no transition before first paint)
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:top-3 focus:left-3 focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-accent-ink focus:no-underline">Skip to content</a>
    <Nav />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
    <Mountains />
  </body>
</html>
