---
import "../styles/global.css";
import { site } from "../config/site";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Mountains from "../components/Mountains.astro";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = site.name,
  description = site.oneLiner,
} = Astro.props;
const fullTitle = title === site.name ? `${site.name} — ${site.tagline}` : `${title} — ${site.name}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Work+Sans:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" />
    <!--
      Alpenglow controller (runs before paint).
      Default: glow follows the visitor's local time of day.
      Override via localStorage key "gs-glow":
        - "cycle"                  → loop through night → dawn → day → dusk
        - "dawn"|"day"|"dusk"|"night" → lock to that preset
        - a number 0..1            → lock to a custom intensity
        - unset / "auto"           → local time (default)
      Cycle speed: localStorage "gs-glow-interval" (ms, default 3500).
      Console helper: gsGlow("cycle" | "dusk" | 0.7 | "auto").
    -->
    <script is:inline>
      (function () {
        var KEY = "gs-glow", INT_KEY = "gs-glow-interval";
        var root = document.documentElement;
        var PRESETS = {
          dawn:  { tod: 0.8,  night: false },
          day:   { tod: 0.3,  night: false },
          dusk:  { tod: 0.9,  night: false },
          night: { tod: 0.15, night: true  }
        };
        var CYCLE = ["night", "dawn", "day", "dusk"];
        var timer = null;

        function ls(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
        function applyState(s) {
          root.style.setProperty("--tod", String(s.tod));
          root.classList.toggle("night", !!s.night);
        }
        function clockName() {
          var h = new Date().getHours();
          return h >= 5 && h < 9 ? "dawn"
               : h >= 9 && h < 16 ? "day"
               : h >= 16 && h < 20 ? "dusk"
               : "night";
        }

        function apply() {
          if (timer) { clearInterval(timer); timer = null; }
          var pref = ls(KEY);
          var reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
          if (pref === "cycle" && !reduce) {
            var i = 0, ms = parseInt(ls(INT_KEY), 10) || 3500;
            applyState(PRESETS[CYCLE[0]]);
            timer = setInterval(function () {
              i = (i + 1) % CYCLE.length;
              applyState(PRESETS[CYCLE[i]]);
            }, ms);
          } else if (pref && PRESETS[pref]) {
            applyState(PRESETS[pref]);
          } else if (pref && !isNaN(parseFloat(pref))) {
            applyState({ tod: Math.max(0, Math.min(1, parseFloat(pref))), night: false });
          } else {
            applyState(PRESETS[clockName()]);
          }
        }

        // Apply immediately + persist, no reload needed.
        window.gsGlow = function (v) {
          try {
            (v == null || v === "auto") ? localStorage.removeItem(KEY) : localStorage.setItem(KEY, String(v));
          } catch (e) {}
          apply();
        };

        apply();
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:top-3 focus:left-3 focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-accent-ink focus:no-underline">Skip to content</a>
    <Nav />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
    <Mountains />
  </body>
</html>
